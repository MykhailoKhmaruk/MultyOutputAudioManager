<Window x:Class="MultyAudioOutput.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultyAudioOutput.ViewModels"
        Title="MultyAudioOutput"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource FgBrush}">
    <Border Margin="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Вивід звуку для програм" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Налаштування"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>

            <!-- Footer -->
            <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleFgBrush}" Text="{Binding HotkeyHint}" />

            <Grid>
                <TextBlock Text="Зараз жодна програма не відтворює звук.&#x0a;Запустіть відео чи гру — вона з'явиться тут."
                           Margin="2,16" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SubtleFgBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasApps}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AppRowViewModel}">
                                <Border Background="{DynamicResource RowBrush}" CornerRadius="6" Padding="10,8" Margin="0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                            <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,2,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" ToolTip="Вибір запам'ятовано"
                                                       Visibility="{Binding IsRemembered, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" ToolTip="Зараз грає"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,4"
                                                  Style="{StaticResource FlatCombo}"
                                                  ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ToggleButton Grid.Row="2" Grid.Column="0" Margin="-6,0,0,0" IsChecked="{Binding IsMuted, Mode=TwoWay}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
                                                    <Setter Property="Content" Value="&#xE767;" />
                                                    <Setter Property="ToolTip" Value="Вимкнути звук" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="&#xE74F;" />
                                                            <Setter Property="ToolTip" Value="Увімкнути звук" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource FlatSlider}" VerticalAlignment="Center"
                                                Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                                Value="{Binding Volume, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" MinWidth="28" TextAlignment="Right" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" Foreground="{DynamicResource SubtleFgBrush}"
                                                   Text="{Binding Volume, StringFormat={}{0:0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
