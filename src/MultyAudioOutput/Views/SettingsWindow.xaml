<Window x:Class="MultyAudioOutput.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MultyAudioOutput.Localization"
        Title="{l:Tr settings.title}"
        Width="560" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,8,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" Content="{l:Tr settings.close}" Click="Close_Click" MinWidth="90" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr settings.general}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr settings.language}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource FlatCombo}"
                                      SelectionChanged="Language_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NativeName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource FlatCheck}" Content="{l:Tr settings.autostart}"
                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                        <CheckBox x:Name="RememberCheck" Style="{StaticResource FlatCheck}" Content="{l:Tr settings.remember}"
                                  Checked="Remember_Changed" Unchecked="Remember_Changed" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr settings.hotkeys}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr settings.cycle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,12,4" />
                        <TextBox x:Name="CycleHotkeyBox" Grid.Column="1" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 Margin="0,4" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="cycle" />
                        <TextBlock Grid.Row="1" Text="{l:Tr settings.flyout}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,12,4" />
                        <TextBox x:Name="FlyoutHotkeyBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 Margin="0,4" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="flyout" />
                        <TextBlock x:Name="HotkeyStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubtleFgBrush}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr settings.rules}" />
                <TextBlock x:Name="NoRulesText" Margin="2,0,0,6" Foreground="{DynamicResource SubtleFgBrush}" TextWrapping="Wrap"
                           Text="{l:Tr settings.noRules}" />
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,3" Padding="14,6,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Run Text="{Binding ExeLabel, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource SubtleFgBrush}" />
                                        </TextBlock>
                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleFgBrush}">
                                            <Run Text="→" />
                                            <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                            <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="{l:Tr settings.deleteRule}"
                                            Click="DeleteRule_Click" Tag="{Binding Key}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr settings.reset}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:Tr settings.resetText}" />
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{l:Tr settings.resetButton}" Click="ResetAll_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
