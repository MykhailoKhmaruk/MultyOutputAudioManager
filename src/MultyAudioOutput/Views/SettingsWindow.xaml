<Window x:Class="MultyAudioOutput.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultyAudioOutput — налаштування"
        Width="560" Height="600" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,8,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Закрити" Click="Close_Click" MinWidth="90" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Загальне" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource FlatCheck}" Content="Запускати разом з Windows"
                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                        <CheckBox x:Name="RememberCheck" Style="{StaticResource FlatCheck}"
                                  Content="Запам'ятовувати вибраний пристрій для кожної програми"
                                  Checked="Remember_Changed" Unchecked="Remember_Changed" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Гарячі клавіші" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Перемкнути вихід активної програми на наступний пристрій"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,12,4" />
                        <TextBox x:Name="CycleHotkeyBox" Grid.Column="1" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 Margin="0,4" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="cycle" />
                        <TextBlock Grid.Row="1" Text="Показати / сховати панель" VerticalAlignment="Center" Margin="0,4,12,4" />
                        <TextBox x:Name="FlyoutHotkeyBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 Margin="0,4" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="flyout" />
                        <TextBlock x:Name="HotkeyStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubtleFgBrush}"
                                   Text="Клацніть у поле й натисніть комбінацію (з Ctrl / Alt / Shift / Win). Backspace — вимкнути." />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Збережені правила" />
                <TextBlock x:Name="NoRulesText" Margin="2,0,0,6" Foreground="{DynamicResource SubtleFgBrush}" TextWrapping="Wrap"
                           Text="Поки що порожньо. Виберіть пристрій для програми в панелі — правило з'явиться тут." />
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,3" Padding="14,6,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Run Text="{Binding ExeLabel, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource SubtleFgBrush}" />
                                        </TextBlock>
                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleFgBrush}">
                                            <Run Text="→" />
                                            <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                            <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Видалити правило"
                                            Click="DeleteRule_Click" Tag="{Binding Key}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Скидання" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Видалити всі правила й повернути всі програми на системний пристрій (також скидає налаштування Windows «Гучність програм»)." />
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Скинути все" Click="ResetAll_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
